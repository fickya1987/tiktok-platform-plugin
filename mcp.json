{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tiktok-platform": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./server/index.mjs"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}",
      "env": {
        "TIKTOK_ACCESS_TOKEN": "${TIKTOK_ACCESS_TOKEN}"
      }
    }
  }
}
